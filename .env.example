JWT_SECRET=<generate-a-strong-shared-secret>
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_USER=
DB_CHANNEL_BINDING=disable
DB_PASSWORD=
DB_NAME=kelolakelas_academic
IDENTITY_GRPC_HOST=localhost:50051
# Per-call bound for identity permission checks; zero, negative, or unset uses 3000.
IDENTITY_PERMISSION_TIMEOUT_MS=3000
PORT=8081
BILLING_SERVICE_URL=http://localhost:8082
INTERNAL_SERVICE_CREDENTIAL=
# How long a catalog tenant snapshot may age before identity is asked again.
CATALOG_TENANT_INFO_TTL_MINUTES=5
# Per-call bound for identity gRPC requests issued by the catalog.
CATALOG_TENANT_INFO_TIMEOUT_MS=2000
# Closed policy reads are cached up to 15s; open reads revalidate each request.
# A failed or untrusted read hides the catalog (never serves stale open).
CATALOG_POLICY_CACHE_TTL_SECONDS=15
CATALOG_POLICY_TIMEOUT_MS=2000
# HTTP server timeouts in seconds; zero, negative, or unset uses the default shown.
# SERVER_WRITE_TIMEOUT_SECONDS must be greater than the 10s billing client timeout,
# otherwise startup fails.
SERVER_READ_HEADER_TIMEOUT_SECONDS=5
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=60
SERVER_IDLE_TIMEOUT_SECONDS=120
# How long in-flight requests may drain after SIGINT/SIGTERM before remaining
# connections are closed; zero, negative, or unset uses 15.
SERVER_SHUTDOWN_TIMEOUT_SECONDS=15
